#!/usr/bin/env python3
"""
Antigravity (AGY) Session Manager
A beautiful, dependency-free CLI tool to view, search, and resume previous Antigravity AI sessions.
"""

import sys
import os
import json
import re
import argparse
import shutil
from datetime import datetime, timedelta
from pathlib import Path
from typing import List, Dict, Optional, Tuple

# Configuration Constants
BRAIN_DIR = Path.home() / '.gemini' / 'antigravity-cli' / 'brain'

# Modern ANSI Colors for Terminal UI
class Colors:
    CYAN = '\033[36m'
    MAGENTA = '\033[35m'
    GREEN = '\033[32m'
    YELLOW = '\033[33m'
    BLUE = '\033[34m'
    RED = '\033[31m'
    DIM = '\033[2m'
    BOLD = '\033[1m'
    RESET = '\033[0m'

def get_relative_time(mtime: float) -> str:
    """Convert a timestamp into a human-readable relative time format."""
    diff = datetime.now() - datetime.fromtimestamp(mtime)
    if diff < timedelta(minutes=1):
        return "Just now"
    if diff < timedelta(hours=1):
        return f"{diff.seconds // 60} min ago"
    if diff < timedelta(days=1):
        return f"{diff.seconds // 3600} hrs ago"
    if diff < timedelta(days=2):
        return "Yesterday"
    return f"{diff.days} days ago"

def extract_user_prompt(log_file: Path) -> str:
    """Safely extract the first meaningful user prompt from a session log file."""
    try:
        with open(log_file, 'r', encoding='utf-8') as f:
            for line in f:
                try:
                    data = json.loads(line)
                    if data.get('type') == 'USER_INPUT':
                        content = data.get('content', '')
                        
                        # Normalize content structure
                        if isinstance(content, dict):
                            content_str = content.get('text', '')
                        elif isinstance(content, list):
                            content_str = ' '.join(str(c) for c in content)
                        else:
                            content_str = str(content)
                        
                        # Extract text from inside <USER_REQUEST> if present
                        match = re.search(r'<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>', content_str, re.DOTALL)
                        prompt_text = match.group(1).strip() if match else content_str.strip()

                        # Strip any remaining XML/HTML tags and normalize whitespace
                        prompt_text = re.sub(r'<[^>]+>', '', prompt_text)
                        clean_prompt = ' '.join(prompt_text.split())
                        
                        if clean_prompt:
                            return clean_prompt
                except json.JSONDecodeError:
                    continue
    except Exception:
        pass
    return "No prompt available"

def get_sessions(search_query: str = "") -> List[Dict]:
    """Fetch and parse all available Antigravity sessions in the brain directory."""
    sessions = []
    if not BRAIN_DIR.exists():
        return sessions

    for conv_dir in BRAIN_DIR.iterdir():
        if not conv_dir.is_dir():
            continue
            
        log_file = conv_dir / '.system_generated' / 'logs' / 'transcript.jsonl'
        if not log_file.exists():
            continue

        mtime = log_file.stat().st_mtime
        prompt = extract_user_prompt(log_file)
        
        pinned = False
        try:
            pinned = (conv_dir / '.agy_pinned').exists()
        except Exception:
            pass
        
        tag_file = conv_dir / '.agy_tag'
        tag = None
        try:
            if tag_file.exists():
                tag = tag_file.read_text(encoding='utf-8').strip()
        except Exception:
            pass
        
        # Filtering by search query if provided
        if search_query:
            sq = search_query.lower()
            if sq not in prompt.lower() and (not tag or sq not in tag.lower()):
                continue

        sessions.append({
            'id': conv_dir.name,
            'mtime': mtime,
            'relative': get_relative_time(mtime),
            'prompt': prompt,
            'path': conv_dir,
            'pinned': pinned,
            'tag': tag
        })

    # Sort descending: pinned first, then by most recent mtime
    sessions.sort(key=lambda x: (not x['pinned'], -x['mtime']))
    return sessions

def print_beautiful_table(sessions: List[Dict], total_count: int, start_idx: int, page: int, total_pages: int, search_query: str = ""):
    """Render a beautiful, dependency-free terminal UI table."""
    print("\033[H\033[J", end="")
    
    title = 'Antigravity (AGY) Session Manager'
    if search_query:
        title += f' [Search: "{search_query}"]'
        
    stats_line = f"Total Chats: {total_count} | Page {page}/{total_pages}" if total_pages > 0 else f"Total Chats: {total_count}"

    print(f"\n{Colors.BOLD}{Colors.CYAN}╭{'─'*117}╮")
    print(f"│ {title.center(115)} │")
    print(f"│ {stats_line.center(115)} │")
    print(f"╰{'─'*117}╯{Colors.RESET}")

    print(f"{Colors.DIM}  {'#':<3} │ {'TIME':<12} │ {'ID / TAG':<20} │ {'FIRST PROMPT PREVIEW'}{Colors.RESET}")
    print(f"{Colors.DIM} ─────┼──────────────┼──────────────────────┼───────────────────────────────────────────────────────────────────────{Colors.RESET}")

    for i, s in enumerate(sessions):
        idx = start_idx + i + 1
        prompt = s['prompt']
        max_len = 71
        prompt_trunc = prompt[:max_len] + '...' if len(prompt) > max_len else prompt.ljust(max_len)
        short_id = s['id'][:8]
        
        pin_indicator = "📌 " if s['pinned'] else ""
        if s['tag']:
            clean_tag = ' '.join(s['tag'].split())
            tag_trunc = clean_tag[:10] + '..' if len(clean_tag) > 12 else clean_tag
            id_tag_str = f"{pin_indicator}{tag_trunc} ({short_id})"
        else:
            id_tag_str = f"{pin_indicator}{short_id}"
            
        id_tag_str = id_tag_str.ljust(20)
        
        idx_str = f"{Colors.BOLD}{Colors.YELLOW}{idx:<3}{Colors.RESET}"
        time_str = f"{Colors.CYAN}{s['relative']:<12}{Colors.RESET}"
        cid_str = f"{Colors.GREEN}{id_tag_str}{Colors.RESET}"
        
        # Highlight search query in prompt if exists
        if search_query:
            insensitive_query = re.compile(re.escape(search_query), re.IGNORECASE)
            prompt_trunc = insensitive_query.sub(rf"{Colors.BOLD}{Colors.MAGENTA}\g<0>{Colors.RESET}", prompt_trunc)

        prompt_str = f"{Colors.RESET}{prompt_trunc}"
        print(f"  {idx_str} │ {time_str} │ {cid_str} │ {prompt_str}")

    print(f"{Colors.DIM} ─────┴──────────────┴──────────────────────┴───────────────────────────────────────────────────────────────────────{Colors.RESET}\n")

def resume_session(session_id: str):
    """Execute the AGY command to resume a specific session."""
    print(f"\n{Colors.GREEN}🚀 Resuming session {Colors.BOLD}{session_id}{Colors.RESET}...\n")
    os.execvp("agy", ["agy", "--conversation", session_id])

def new_session():
    """Start a completely new AGY session."""
    print(f"\n{Colors.GREEN}✨ Starting a new session...{Colors.RESET}\n")
    os.execvp("agy", ["agy"])

def _safe_delete_session(path: Path):
    """Delete a session, handling symlinks correctly."""
    if path.is_symlink():
        path.unlink()
    else:
        shutil.rmtree(path)

def delete_session(session: Dict):
    """Safely delete a session directory."""
    print(f"\n{Colors.RED}⚠️  WARNING: You are about to delete session {Colors.BOLD}{session['id'][:8]}{Colors.RESET}")
    print(f"Prompt: {Colors.DIM}{session['prompt']}{Colors.RESET}")
    confirm = input(f"Are you sure? [y/N]: ").strip().lower()
    
    if confirm in ['y', 'yes']:
        try:
            _safe_delete_session(session['path'])
            print(f"{Colors.GREEN}✅ Session deleted successfully.{Colors.RESET}")
        except Exception as e:
            print(f"{Colors.RED}❌ Error deleting session: {e}{Colors.RESET}")
    else:
        print(f"{Colors.DIM}Deletion cancelled.{Colors.RESET}")

def clear_all_sessions(sessions: List[Dict]):
    """Safely delete all sessions."""
    if not sessions:
        print(f"{Colors.YELLOW}No sessions to clear.{Colors.RESET}")
        return
        
    print(f"\n{Colors.RED}⚠️  WARNING: You are about to delete ALL {len(sessions)} sessions.{Colors.RESET}")
    confirm = input(f"Are you absolutely sure? Type 'YES' to confirm: ").strip()
    
    if confirm == 'YES':
        count = 0
        for s in sessions:
            try:
                _safe_delete_session(s['path'])
                count += 1
            except Exception as e:
                print(f"{Colors.RED}❌ Error deleting {s['id'][:8]}: {e}{Colors.RESET}")
        print(f"{Colors.GREEN}✅ {count} sessions deleted successfully.{Colors.RESET}")
    else:
        print(f"{Colors.DIM}Clear all cancelled.{Colors.RESET}")

def toggle_pin(session: Dict, pin: bool):
    pin_file = session['path'] / '.agy_pinned'
    try:
        if pin:
            pin_file.touch()
            print(f"{Colors.GREEN}✅ Session {session['id'][:8]} pinned.{Colors.RESET}")
        else:
            if pin_file.exists():
                pin_file.unlink()
            print(f"{Colors.GREEN}✅ Session {session['id'][:8]} unpinned.{Colors.RESET}")
    except Exception as e:
        print(f"{Colors.RED}❌ Error updating pin: {e}{Colors.RESET}")

def set_tag(session: Dict, tag: str):
    tag_file = session['path'] / '.agy_tag'
    try:
        if tag:
            tag_file.write_text(tag, encoding='utf-8')
            print(f"{Colors.GREEN}✅ Session {session['id'][:8]} tagged as '{tag}'.{Colors.RESET}")
        else:
            if tag_file.exists():
                tag_file.unlink()
            print(f"{Colors.GREEN}✅ Tag removed from session {session['id'][:8]}.{Colors.RESET}")
    except Exception as e:
        print(f"{Colors.RED}❌ Error updating tag: {e}{Colors.RESET}")

def resolve_session_selection(select_str: str, sessions: List[Dict]) -> Optional[Dict]:
    """Resolve a user input string (index or ID) to a session."""
    # 1. Exact match
    for s in sessions:
        if s['id'] == select_str:
            return s
            
    # 2. Index match
    if select_str.isdigit():
        idx = int(select_str) - 1
        if 0 <= idx < len(sessions):
            return sessions[idx]
            
    # 3. Prefix match
    for s in sessions:
        if s['id'].startswith(select_str):
            return s
            
    return None

def main():
    parser = argparse.ArgumentParser(description="Beautiful Antigravity (agy) session manager")
    parser.add_argument("select", nargs="?", help="Session index (1-based) or Session ID to resume")
    parser.add_argument("-n", "--number", type=int, default=15, help="Number of sessions to show per page")
    parser.add_argument("-p", "--page", type=int, default=1, help="Page number to display")
    parser.add_argument("-s", "--search", type=str, help="Search sessions by prompt text or tag")
    parser.add_argument("-d", "--delete", action="store_true", help="Delete a session (prompts for selection)")
    parser.add_argument("-t", "--tag", type=str, help="Assign a custom name/tag to a session")
    parser.add_argument("--pin", action="store_true", help="Pin a session")
    parser.add_argument("--unpin", action="store_true", help="Unpin a session")
    parser.add_argument("--clear-all", action="store_true", help="Delete all sessions")
    args = parser.parse_args()

    sessions = get_sessions(search_query=args.search)
    total_count = len(sessions)
    
    if args.clear_all:
        clear_all_sessions(sessions)
        return

    # If select is provided with a modifier (tag, pin, unpin, delete), apply it and exit.
    if args.select and (args.tag is not None or args.pin or args.unpin or args.delete):
        session = resolve_session_selection(args.select, sessions)
        if not session:
            print(f"{Colors.RED}Error: Session not found.{Colors.RESET}")
            sys.exit(1)
            
        if args.tag is not None:
            set_tag(session, args.tag)
        if args.pin:
            toggle_pin(session, True)
        if args.unpin:
            toggle_pin(session, False)
        if args.delete:
            delete_session(session)
        return

    # If just select is provided, resume it immediately.
    if args.select:
        session = resolve_session_selection(args.select, sessions)
        if session:
            resume_session(session['id'])
        else:
            print(f"{Colors.RED}Error: Session not found.{Colors.RESET}")
            sys.exit(1)
        return

    if not sessions:
        if args.search:
            print(f"{Colors.YELLOW}No sessions found matching '{args.search}'. Total chats: {total_count}{Colors.RESET}")
        else:
            print(f"{Colors.YELLOW}No previous Antigravity sessions found.{Colors.RESET}")
        
        choice = input(f"\n{Colors.MAGENTA}❯ Type 'n' to start a new chat (or Enter to exit): {Colors.RESET}").strip().lower()
        if choice == 'n':
            new_session()
        sys.exit(0)

    # Interactive flow
    page = args.page
    limit = args.number if args.number > 0 else total_count
    interactive_delete = args.delete
    action_text = "delete" if interactive_delete else "resume"
    color = Colors.RED if interactive_delete else Colors.MAGENTA

    while True:
        total_pages = (total_count + limit - 1) // limit
        page = max(1, min(page, total_pages)) if total_pages > 0 else 1
        
        start_idx = (page - 1) * limit
        end_idx = start_idx + limit
        displayed_sessions = sessions[start_idx:end_idx]

        print_beautiful_table(displayed_sessions, total_count=total_count, start_idx=start_idx, page=page, total_pages=total_pages, search_query=args.search)

        try:
            prompt_actions = [f"number to {action_text}", "'n' for new"]
            if total_pages > 1:
                prompt_actions.append("'>' next, '<' prev")
            prompt_str = ", ".join(prompt_actions)
            
            choice = input(f" {Colors.BOLD}{color}❯ Enter {prompt_str} {Colors.DIM}(or Enter to exit): {Colors.RESET}").strip().lower()
            
            if not choice:
                break
            elif choice == 'n':
                new_session()
                break
            elif choice in ['>', 'next'] and page < total_pages:
                page += 1
            elif choice in ['<', 'prev'] and page > 1:
                page -= 1
            elif choice.isdigit():
                idx = int(choice) - 1
                if 0 <= idx < total_count:
                    if interactive_delete:
                        delete_session(sessions[idx])
                        # Refresh after delete
                        sessions = get_sessions(search_query=args.search)
                        total_count = len(sessions)
                        if not sessions:
                            break
                    else:
                        resume_session(sessions[idx]['id'])
                        break
                else:
                    print(f"\n{Colors.YELLOW}Invalid selection.{Colors.RESET}")
            else:
                print(f"\n{Colors.YELLOW}Invalid command.{Colors.RESET}")
        except (KeyboardInterrupt, EOFError):
            print(f"\n{Colors.DIM}Cancelled.{Colors.RESET}")
            break

if __name__ == "__main__":
    main()
