#!/usr/bin/env python3
"""
Antigravity (AGY) Session Manager
A beautiful, dependency-free CLI tool to view, search, and resume previous Antigravity AI sessions.
"""

import sys
import os
import json
import re
import argparse
import shutil
from datetime import datetime, timedelta
from pathlib import Path
from typing import List, Dict, Optional, Tuple

# Configuration Constants
BRAIN_DIR = Path.home() / '.gemini' / 'antigravity-cli' / 'brain'

# Modern ANSI Colors for Terminal UI
class Colors:
    CYAN = '\033[36m'
    MAGENTA = '\033[35m'
    GREEN = '\033[32m'
    YELLOW = '\033[33m'
    BLUE = '\033[34m'
    RED = '\033[31m'
    DIM = '\033[2m'
    BOLD = '\033[1m'
    RESET = '\033[0m'

def get_relative_time(mtime: float) -> str:
    """Convert a timestamp into a human-readable relative time format."""
    diff = datetime.now() - datetime.fromtimestamp(mtime)
    if diff < timedelta(minutes=1):
        return "Just now"
    if diff < timedelta(hours=1):
        return f"{diff.seconds // 60} min ago"
    if diff < timedelta(days=1):
        return f"{diff.seconds // 3600} hrs ago"
    if diff < timedelta(days=2):
        return "Yesterday"
    return f"{diff.days} days ago"

def extract_user_prompt(log_file: Path) -> str:
    """Safely extract the first meaningful user prompt from a session log file."""
    try:
        with open(log_file, 'r', encoding='utf-8') as f:
            for line in f:
                try:
                    data = json.loads(line)
                    if data.get('type') == 'USER_INPUT':
                        content = data.get('content', '')
                        
                        # Normalize content structure
                        if isinstance(content, dict):
                            content_str = content.get('text', '')
                        elif isinstance(content, list):
                            content_str = ' '.join(str(c) for c in content)
                        else:
                            content_str = str(content)
                        
                        # Extract text from inside <USER_REQUEST> if present
                        match = re.search(r'<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>', content_str, re.DOTALL)
                        prompt_text = match.group(1).strip() if match else content_str.strip()

                        # Strip any remaining XML/HTML tags and normalize whitespace
                        prompt_text = re.sub(r'<[^>]+>', '', prompt_text)
                        clean_prompt = ' '.join(prompt_text.split())
                        
                        if clean_prompt:
                            return clean_prompt
                except json.JSONDecodeError:
                    continue
    except Exception:
        pass
    return "No prompt available"

def get_sessions(search_query: str = "") -> List[Dict]:
    """Fetch and parse all available Antigravity sessions in the brain directory."""
    sessions = []
    if not BRAIN_DIR.exists():
        return sessions

    for conv_dir in BRAIN_DIR.iterdir():
        if not conv_dir.is_dir():
            continue
            
        log_file = conv_dir / '.system_generated' / 'logs' / 'transcript.jsonl'
        if not log_file.exists():
            continue

        mtime = log_file.stat().st_mtime
        prompt = extract_user_prompt(log_file)
        
        # Filtering by search query if provided
        if search_query and search_query.lower() not in prompt.lower():
            continue

        sessions.append({
            'id': conv_dir.name,
            'mtime': mtime,
            'relative': get_relative_time(mtime),
            'prompt': prompt,
            'path': conv_dir
        })

    # Sort descending (most recent first)
    sessions.sort(key=lambda x: x['mtime'], reverse=True)
    return sessions

def print_beautiful_table(sessions: List[Dict], total_count: int, search_query: str = ""):
    """Render a beautiful, dependency-free terminal UI table."""
    print("\033[H\033[J", end="")
    
    title = 'Antigravity (AGY) Session Manager'
    if search_query:
        title += f' [Search: "{search_query}"]'
        
    stats_line = f"Total Chats: {total_count} | Shown: {len(sessions)}"

    print(f"\n{Colors.BOLD}{Colors.CYAN}╭{'─'*117}╮")
    print(f"│ {title.center(115)} │")
    print(f"│ {stats_line.center(115)} │")
    print(f"╰{'─'*117}╯{Colors.RESET}")

    print(f"{Colors.DIM}  {'#':<3} │ {'TIME':<12} │ {'SESSION':<8} │ {'FIRST PROMPT PREVIEW'}{Colors.RESET}")
    print(f"{Colors.DIM} ─────┼──────────────┼──────────┼─────────────────────────────────────────────────────────────────────────────────────{Colors.RESET}")

    for idx, s in enumerate(sessions, 1):
        prompt = s['prompt']
        max_len = 83
        prompt_trunc = prompt[:max_len] + '...' if len(prompt) > max_len else prompt.ljust(max_len)
        short_id = s['id'][:8]
        
        idx_str = f"{Colors.BOLD}{Colors.YELLOW}{idx:<3}{Colors.RESET}"
        time_str = f"{Colors.CYAN}{s['relative']:<12}{Colors.RESET}"
        cid_str = f"{Colors.GREEN}{short_id:<8}{Colors.RESET}"
        
        # Highlight search query in prompt if exists
        if search_query:
            insensitive_query = re.compile(re.escape(search_query), re.IGNORECASE)
            prompt_trunc = insensitive_query.sub(f"{Colors.BOLD}{Colors.MAGENTA}\\\\g<0>{Colors.RESET}", prompt_trunc)

        prompt_str = f"{Colors.RESET}{prompt_trunc}"
        print(f"  {idx_str} │ {time_str} │ {cid_str} │ {prompt_str}")

    print(f"{Colors.DIM} ─────┴──────────────┴──────────┴─────────────────────────────────────────────────────────────────────────────────────{Colors.RESET}\n")

def resume_session(session_id: str):
    """Execute the AGY command to resume a specific session."""
    print(f"\n{Colors.GREEN}🚀 Resuming session {Colors.BOLD}{session_id}{Colors.RESET}...\n")
    os.execvp("agy", ["agy", "--conversation", session_id])

def new_session():
    """Start a completely new AGY session."""
    print(f"\n{Colors.GREEN}✨ Starting a new session...{Colors.RESET}\n")
    os.execvp("agy", ["agy"])

def delete_session(session: Dict):
    """Safely delete a session directory."""
    print(f"\n{Colors.RED}⚠️  WARNING: You are about to delete session {Colors.BOLD}{session['id'][:8]}{Colors.RESET}")
    print(f"Prompt: {Colors.DIM}{session['prompt']}{Colors.RESET}")
    confirm = input(f"Are you sure? [y/N]: ").strip().lower()
    
    if confirm in ['y', 'yes']:
        try:
            shutil.rmtree(session['path'])
            print(f"{Colors.GREEN}✅ Session deleted successfully.{Colors.RESET}")
        except Exception as e:
            print(f"{Colors.RED}❌ Error deleting session: {e}{Colors.RESET}")
    else:
        print(f"{Colors.DIM}Deletion cancelled.{Colors.RESET}")

def main():
    parser = argparse.ArgumentParser(description="Beautiful Antigravity (agy) session manager")
    parser.add_argument("select", nargs="?", help="Session index (1-based) or Session ID to resume")
    parser.add_argument("-n", "--number", type=int, default=15, help="Number of recent sessions to show")
    parser.add_argument("-s", "--search", type=str, help="Search sessions by prompt text")
    parser.add_argument("-d", "--delete", action="store_true", help="Delete a session (prompts for selection)")
    args = parser.parse_args()

    all_sessions = get_sessions(search_query="")
    total_count = len(all_sessions)
    
    # Filter by search if necessary
    if args.search:
        sessions = [s for s in all_sessions if args.search.lower() in s['prompt'].lower()]
    else:
        sessions = all_sessions

    if not sessions:
        if args.search:
            print(f"{Colors.YELLOW}No sessions found matching '{args.search}'. Total chats: {total_count}{Colors.RESET}")
        else:
            print(f"{Colors.YELLOW}No previous Antigravity sessions found.{Colors.RESET}")
        
        # Even if empty, allow new chat
        choice = input(f"\n{Colors.MAGENTA}❯ Type 'n' to start a new chat (or Enter to exit): {Colors.RESET}").strip().lower()
        if choice == 'n':
            new_session()
        sys.exit(0)

    # Truncate to display limit
    display_limit = args.number if args.number > 0 else len(sessions)
    displayed_sessions = sessions[:display_limit]

    # Direct select
    if args.select:
        if args.select.isdigit():
            idx = int(args.select) - 1
            if 0 <= idx < len(displayed_sessions):
                if args.delete:
                    delete_session(displayed_sessions[idx])
                else:
                    resume_session(displayed_sessions[idx]['id'])
            else:
                print(f"{Colors.RED}Error: Index out of range.{Colors.RESET}")
                sys.exit(1)
        else:
            resume_session(args.select)
        return

    print_beautiful_table(displayed_sessions, total_count=total_count, search_query=args.search)

    try:
        action_text = "delete" if args.delete else "resume"
        color = Colors.RED if args.delete else Colors.MAGENTA
        
        choice = input(f" {Colors.BOLD}{color}❯ Enter session number to {action_text}, 'n' for new chat {Colors.DIM}(or press Enter to exit): {Colors.RESET}").strip().lower()
        
        if choice == 'n':
            new_session()
        elif choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(displayed_sessions):
                if args.delete:
                    delete_session(displayed_sessions[idx])
                else:
                    resume_session(displayed_sessions[idx]['id'])
            else:
                print(f"\n{Colors.YELLOW}Invalid selection.{Colors.RESET}")
    except (KeyboardInterrupt, EOFError):
        print(f"\n{Colors.DIM}Cancelled.{Colors.RESET}")

if __name__ == "__main__":
    main()
